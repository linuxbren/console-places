pkgbase = tidefiles
	pkgdesc = Keyboard-first terminal file manager that follows your Omarchy theme
	pkgver = 0.9.1
	pkgrel = 1
	url = https://github.com/linuxbren/tidefiles
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = go
	depends = glibc
	depends = wl-clipboard
	depends = glib2
	optdepends = ripgrep: faster search inside files
	optdepends = 7zip: archives bsdtar cannot open
	optdepends = imagemagick: previews of jpeg, svg, heic and other images
	optdepends = poppler: PDF previews
	optdepends = ffmpegthumbnailer: video previews
	optdepends = ffmpeg: playing videos and audio tags in previews
	optdepends = xdg-utils: open files in their default app
	optdepends = xdg-terminal-exec: open a terminal here
	optdepends = udisks2: mount drives
	optdepends = gvfs: connect to servers (network places)
	optdepends = gvfs-smb: Windows, Mac and Samba shares
	optdepends = gvfs-nfs: NFS shares
	optdepends = avahi: find computers on the network
	optdepends = smbclient: list the shares on a server
	optdepends = cifs-utils: system (root) SMB mounts
	optdepends = nfs-utils: system (root) NFS mounts
