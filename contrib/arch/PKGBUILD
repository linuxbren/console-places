# Maintainer: linuxbren <linuxbren@gmail.com>
#
# Build from source with:  makepkg -si   (in this folder)
# To update: bump pkgver, run `updpkgsums`, then `makepkg --printsrcinfo > .SRCINFO`.
pkgname=tidefiles
pkgver=0.8.1
pkgrel=1
pkgdesc="Keyboard-first terminal file manager that follows your Omarchy theme"
arch=('x86_64' 'aarch64')
url="https://github.com/linuxbren/tidefiles"
license=('MIT')
depends=('glibc' 'wl-clipboard' 'glib2')
makedepends=('go')
optdepends=(
  'ripgrep: faster search inside files'
  '7zip: archives bsdtar cannot open'
  'imagemagick: previews of jpeg, svg, heic and other images'
  'poppler: PDF previews'
  'ffmpegthumbnailer: video previews'
  'ffmpeg: audio tags in previews'
  'xdg-utils: open files in their default app'
  'xdg-terminal-exec: open a terminal here'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('7de489519835d0278635534b153f8aec055f2ce79c8c672ade47702af7304f66')

prepare() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export GOFLAGS="-modcacherw" # keep the module cache removable, so makepkg can clean up
  go mod download
}

build() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-linkmode=external -X main.version=v$pkgver" -o tidefiles .
}

check() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 tidefiles "$pkgdir/usr/bin/tidefiles"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  # Optional Omarchy/Hyprland snippet for SUPER+C (see README); never applied automatically.
  install -Dm644 contrib/omarchy-super-c.lua "$pkgdir/usr/share/$pkgname/omarchy-super-c.lua"
}
